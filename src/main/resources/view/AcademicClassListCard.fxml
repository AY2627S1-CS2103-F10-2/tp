<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<HBox fx:id="cardPane" id="cardPane" minWidth="0" prefWidth="0"
      styleClass="class-row" alignment="TOP_LEFT"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <Label fx:id="id" styleClass="card-index" minWidth="-Infinity" />
  <VBox spacing="4" minWidth="0" HBox.hgrow="ALWAYS">
    <FlowPane fx:id="classHeading" minWidth="0" prefWrapLength="280" hgap="5" vgap="2">
      <Label fx:id="moduleCode" styleClass="module-code" minWidth="0" wrapText="true" />
      <Label fx:id="className" styleClass="class-title" minWidth="0" wrapText="true" />
    </FlowPane>
    <Label fx:id="studentCount" styleClass="muted" />
  </VBox>
</HBox>
