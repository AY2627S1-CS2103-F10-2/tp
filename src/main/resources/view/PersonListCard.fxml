<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox id="cardPane" fx:id="cardPane" minWidth="0" prefWidth="0"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <VBox spacing="6" minWidth="0" HBox.hgrow="ALWAYS">
    <HBox spacing="2" alignment="TOP_LEFT" minWidth="0">
      <Label fx:id="id" styleClass="cell_big_label" minWidth="-Infinity" />
      <Label fx:id="name" styleClass="cell_big_label" minWidth="0" maxWidth="Infinity"
             wrapText="true" HBox.hgrow="ALWAYS" />
    </HBox>
    <VBox fx:id="details" spacing="4" minWidth="0" styleClass="student-details">
      <HBox spacing="12" minWidth="0">
        <Label fx:id="studentNumber" styleClass="cell_small_label" minWidth="0" wrapText="true" />
        <Label fx:id="email" styleClass="cell_small_label" minWidth="0" maxWidth="Infinity"
               wrapText="true" HBox.hgrow="ALWAYS" />
      </HBox>
      <Label fx:id="telegram" styleClass="cell_small_label" minWidth="0" maxWidth="Infinity"
             wrapText="true" />
    </VBox>
    <FlowPane fx:id="tags" minWidth="0" prefWrapLength="280" />
    <VBox fx:id="attendanceSection" spacing="5" minWidth="0" visible="false" managed="false"
          styleClass="attendance-section">
      <Label fx:id="attendance" styleClass="attendance-summary cell_small_label"
             wrapText="true" />
      <VBox fx:id="attendanceMonths" spacing="4" minWidth="0" />
    </VBox>
  </VBox>
</HBox>
