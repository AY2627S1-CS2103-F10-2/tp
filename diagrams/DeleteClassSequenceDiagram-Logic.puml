@startuml
!include style.puml
skinparam ArrowFontStyle plain
title Successful deletion of the first displayed class

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant ":DeleteClassCommandParser" as DeleteClassCommandParser LOGIC_COLOR
participant "d:DeleteClassCommand" as DeleteClassCommand LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
end box

note over Model : At least one class is displayed before the command runs.

[-> LogicManager : execute("deleteclass 1")
activate LogicManager

LogicManager -> AddressBookParser : parseCommand("deleteclass 1")
activate AddressBookParser

create DeleteClassCommandParser
AddressBookParser -> DeleteClassCommandParser
AddressBookParser -> DeleteClassCommandParser : parse(" 1")
activate DeleteClassCommandParser
note right of DeleteClassCommandParser
targetIndex = Index.fromOneBased(1)
end note

create DeleteClassCommand
DeleteClassCommandParser -> DeleteClassCommand : DeleteClassCommand(targetIndex)
DeleteClassCommandParser --> AddressBookParser : d
deactivate DeleteClassCommandParser

AddressBookParser --> LogicManager : d
deactivate AddressBookParser

LogicManager -> DeleteClassCommand : execute(m)
activate DeleteClassCommand

DeleteClassCommand -> Model : getFilteredAcademicClassList()
activate Model
Model --> DeleteClassCommand : displayedClasses
deactivate Model

note right of DeleteClassCommand
Validate targetIndex against displayedClasses.size()
classToDelete = displayedClasses.get(targetIndex.getZeroBased())
end note

DeleteClassCommand -> Model : deleteAcademicClass(classToDelete)
activate Model
Model --> DeleteClassCommand
deactivate Model
note right of Model : The selected class has been removed.

DeleteClassCommand --> LogicManager : result
deactivate DeleteClassCommand
note over LogicManager : result.feedbackToUser = "Deleted class: " + classToDelete

[<-- LogicManager : result
deactivate LogicManager
@enduml
