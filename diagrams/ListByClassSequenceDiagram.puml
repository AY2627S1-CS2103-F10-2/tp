@startuml
!include style.puml
skinparam ArrowFontStyle plain
mainframe sd List students by class (successful execution)

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant ":ListByClassCommandParser" as Parser LOGIC_COLOR
participant "c:ListByClassCommand" as Command LOGIC_COLOR
participant "r:CommandResult" as Result LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:ModelManager" as Model MODEL_COLOR
end box

note over LogicManager, AddressBookParser
commandText = "listbyclass m/CS2103 c/F10-2"
args = " m/CS2103 c/F10-2"
The specified class exists.
end note

[-> LogicManager : execute(commandText)
activate LogicManager
LogicManager -> AddressBookParser : parseCommand(commandText)
activate AddressBookParser

create Parser
AddressBookParser -> Parser : ListByClassCommandParser()
activate Parser
Parser --> AddressBookParser
deactivate Parser

AddressBookParser -> Parser : parse(args)
activate Parser
create Command
Parser -> Command : ListByClassCommand(moduleCode, className)
activate Command
Command --> Parser
deactivate Command
Parser --> AddressBookParser : c
deactivate Parser
AddressBookParser --> LogicManager : c
deactivate AddressBookParser

LogicManager -> Command : execute(m)
activate Command
Command -> Model : findAcademicClass(moduleCode, className)
activate Model
Model --> Command : Optional.of(academicClass)
deactivate Model

Command -> Model : filterPersonsByClass(academicClass)
activate Model
note right of Model
Filter students by class membership
and sort by name.
The class view is unchanged.
end note
Model --> Command
deactivate Model

Command -> Model : getFilteredPersonList()
activate Model
Model --> Command : displayedPersons
deactivate Model

create Result
Command -> Result : CommandResult(successMessage)
activate Result
Result --> Command
deactivate Result
Command --> LogicManager : r
deactivate Command

note right of LogicManager
LogicManager saves the address book
before returning (storage calls omitted).
Assume saving succeeds.
end note
[<-- LogicManager : r
deactivate LogicManager
@enduml
