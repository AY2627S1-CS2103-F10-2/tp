@startuml
!include style.puml
skinparam ArrowFontStyle plain
mainframe sd Record attendance (successful execution)

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant ":AddAttendanceCommandParser" as Parser LOGIC_COLOR
participant "c:AddAttendanceCommand" as Command LOGIC_COLOR
participant "r:CommandResult" as Result LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:ModelManager" as Model MODEL_COLOR
end box

note over LogicManager, AddressBookParser
commandText = "addattendance 1 2 d/2024-02-29"
args = " 1 2 d/2024-02-29"
Student 1 and class 2 exist in their displayed lists.
The student is assigned to the class.
The date is not in the future and is not recorded.
Saving succeeds.
end note

[-> LogicManager : execute(commandText)
activate LogicManager
LogicManager -> AddressBookParser : parseCommand(commandText)
activate AddressBookParser
create Parser
AddressBookParser -> Parser : AddAttendanceCommandParser()
activate Parser
Parser --> AddressBookParser
deactivate Parser
AddressBookParser -> Parser : parse(args)
activate Parser
note right of Parser
Validate one d/ prefix, two positive indices
and a calendar date using shared parser helpers.
end note
create Command
Parser -> Command : AddAttendanceCommand(studentIndex, classIndex, date)
activate Command
Command --> Parser
deactivate Command
Parser --> AddressBookParser : c
deactivate Parser
AddressBookParser --> LogicManager : c
deactivate AddressBookParser

LogicManager -> Command : execute(m)
activate Command
Command -> Model : getFilteredPersonList()
activate Model
Model --> Command : displayedStudents
deactivate Model
note right of Command
Check studentIndex and select person.
end note
Command -> Model : getFilteredAcademicClassList()
activate Model
Model --> Command : displayedClasses
deactivate Model
note right of Command
Check classIndex and select academicClass.
Check that person is assigned to academicClass.
end note
Command -> Model : addAttendance(person, academicClass, date)
activate Model
note right of Model
Delegate to AddressBook using stored endpoints.
Reuse or create the student-class Attendance record.
Attendance.addDate(date) records the new date.
On success, refresh the student list using
its existing filter and attendance threshold.
end note
Model --> Command : true
deactivate Model

create Result
Command -> Result : CommandResult(successMessage)
activate Result
Result --> Command
deactivate Result
Command --> LogicManager : r
deactivate Command
note right of LogicManager
Record successful command history and save
via Storage before returning (calls omitted).
end note
[<-- LogicManager : r
deactivate LogicManager
@enduml
