@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

title Student records and related data (partial model)

Class "<<interface>>\nStudentObserver" as StudentObserver

AddressBook *--> "1" UniquePersonList
UniquePersonList --> "*" Person
AddressBook *--> "1" UniqueAcademicClassList
UniqueAcademicClassList --> "*" AcademicClass
AcademicClass "*" --> "*" Person : students
AcademicClass ..|> StudentObserver
AddressBook --> "*" StudentObserver : notifies on student changes
AddressBook *--> "*" Attendance
Attendance --> "1" Person : student
Attendance --> "1" AcademicClass : academicClass
AcademicClass *--> "1" ModuleCode
AcademicClass *--> "1" ClassName

Person *--> "*" Tag
Person *--> StudentNumber
Person *--> Name
Person *--> Email
Person *--> "0..1" Telegram
@enduml
