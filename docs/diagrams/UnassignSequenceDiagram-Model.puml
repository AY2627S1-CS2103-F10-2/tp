@startuml
!include style.puml
skinparam ArrowFontStyle plain

mainframe sd Unassign membership (model)

box Model MODEL_COLOR_T1
participant "m:ModelManager" as Model MODEL_COLOR
participant ":AddressBook" as AddressBook MODEL_COLOR
participant "academicClass:AcademicClass" as AcademicClass MODEL_COLOR
end box

    [-> Model : unassignStudentFromClass(person, academicClass)
    activate Model

    Model -> AddressBook : unassignStudentFromClass(person, academicClass)
    activate AddressBook

    AddressBook -> AcademicClass : unassignStudent(person)
    activate AcademicClass
    note over AcademicClass
    Remove person from the student set.
    No student record or class is deleted.
    end note
    AcademicClass --> AddressBook : true
    deactivate AcademicClass

    AddressBook --> Model : true
    deactivate AddressBook

    [<-- Model : true
    deactivate Model
@enduml
