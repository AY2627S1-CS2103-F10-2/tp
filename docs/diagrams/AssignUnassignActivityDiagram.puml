@startuml
skin rose
skinparam ActivityFontSize 15
skinparam ArrowFontSize 12

start
:Parse assign or unassign arguments:
STUDENT_INDEX CLASS_INDEX;
note right
Exactly two positive integer indices.
Student index first, class index second.
end note

' Guards are on the outgoing branches, matching CommitActivityDiagram.puml.
if () then ([invalid arguments])
    :Report input error;
    stop
else ([valid arguments])
endif

:Resolve student index in displayed student list;
if () then ([student index out of range])
    :Report invalid displayed student index;
    stop
else ([valid student index])
endif
:Resolve class index in displayed class list;
if () then ([class index out of range])
    :Report invalid displayed class index;
    stop
else ([valid class index])
endif

if () then ([assign])
    :Attempt to assign student to a class
    through the Model;
    if () then ([class already contain student])
        :Report student already assigned;
        stop
    else ([else])
    endif
else ([unassign])
    :Attempt to unassign student from a class
    through the Model;
    if () then ([class does not contain student])
        :Report student not assigned;
        stop
    else ([else])
    endif
endif

:Create success CommandResult;
:Save the address book;
if () then ([saving fails])
    :Report save error;
    note right
    The in-memory membership change
    is not rolled back.
    end note
    stop
else ([saving succeeds])
endif

:Return success CommandResult;
stop
@enduml
