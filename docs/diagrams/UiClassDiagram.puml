@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor UI_COLOR_T4
skinparam classBackgroundColor UI_COLOR

' Custom JavaFX controls are described in the Developer Guide prose.
' Type parameters, command helpers, and internal list cells/skins are omitted.
package UI <<Rectangle>> {
Class "<<interface>>\nUi" as Ui
Class "{abstract}\nUiPart" as UiPart
Class UiManager
Class MainWindow
Class HelpWindow
Class ResultDisplay
Class PersonListPanel
Class PersonCard
Class AcademicClassListPanel
Class AcademicClassCard
Class StatusBarFooter
Class CommandBox
}

package Model <<Rectangle>> {
Class HiddenModel #FFFFFF
}

package Logic <<Rectangle>> {
Class HiddenLogic #FFFFFF
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Ui

UiManager .left.|> Ui
UiManager -down-> "1" MainWindow
MainWindow *-down->  "1" CommandBox
MainWindow *-down-> "1" ResultDisplay
MainWindow *-down-> "1" PersonListPanel
MainWindow *-down-> "1" AcademicClassListPanel
MainWindow *-down-> "1" StatusBarFooter
MainWindow *-down-> "1" HelpWindow

PersonListPanel -down-> "*" PersonCard
AcademicClassListPanel -down-> "*" AcademicClassCard

MainWindow -left-|> UiPart

ResultDisplay --|> UiPart
CommandBox --|> UiPart
PersonListPanel --|> UiPart
PersonCard --|> UiPart
AcademicClassListPanel --|> UiPart
AcademicClassCard --|> UiPart
StatusBarFooter --|> UiPart
HelpWindow --|> UiPart

PersonCard ..> Model
AcademicClassCard ..> Model
UiManager -right-> Logic
MainWindow -left-> Logic

' Follow the AB3 layout, with matching student and academic-class panels/cards.
PersonListPanel -[hidden]left- HelpWindow
HelpWindow -[hidden]left- CommandBox
CommandBox -[hidden]left- ResultDisplay
ResultDisplay -[hidden]left- StatusBarFooter
PersonListPanel -[hidden]right- AcademicClassListPanel
PersonCard -[hidden]right- AcademicClassCard

MainWindow -[hidden]-|> UiPart
@enduml
