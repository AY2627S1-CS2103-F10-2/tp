@startuml
!include style.puml
skinparam ArrowFontStyle plain
title Successful deletion of CS2103-F10-2

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant ":DeleteClassCommandParser" as DeleteClassCommandParser LOGIC_COLOR
participant "d:DeleteClassCommand" as DeleteClassCommand LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
participant "ab:ReadOnlyAddressBook" as AddressBook MODEL_COLOR
end box

note over Model, AddressBook : CS2103-F10-2 exists before the command runs.

[-> LogicManager : execute("deleteclass m/CS2103 c/F10-2")
activate LogicManager

LogicManager -> AddressBookParser : parseCommand("deleteclass m/CS2103 c/F10-2")
activate AddressBookParser

create DeleteClassCommandParser
AddressBookParser -> DeleteClassCommandParser
AddressBookParser -> DeleteClassCommandParser : parse(" m/CS2103 c/F10-2")
activate DeleteClassCommandParser
note right of DeleteClassCommandParser
moduleCode = ModuleCode("CS2103")
className = ClassName("F10-2")
end note

create DeleteClassCommand
DeleteClassCommandParser -> DeleteClassCommand : DeleteClassCommand(moduleCode, className)
DeleteClassCommandParser --> AddressBookParser : d
deactivate DeleteClassCommandParser

AddressBookParser --> LogicManager : d
deactivate AddressBookParser

LogicManager -> DeleteClassCommand : execute(m)
activate DeleteClassCommand

DeleteClassCommand -> Model : getAddressBook()
activate Model
Model --> DeleteClassCommand : ab
deactivate Model

DeleteClassCommand -> AddressBook : findAcademicClass(moduleCode, className)
activate AddressBook
AddressBook --> DeleteClassCommand : Optional.of(classToDelete)
deactivate AddressBook

DeleteClassCommand -> Model : deleteAcademicClass(classToDelete)
activate Model
Model --> DeleteClassCommand
deactivate Model
note right of Model : CS2103-F10-2 has been removed.

DeleteClassCommand --> LogicManager : result
deactivate DeleteClassCommand
note over LogicManager : result.feedbackToUser = "Deleted class: CS2103-F10-2"

[<-- LogicManager : result
deactivate LogicManager
@enduml
