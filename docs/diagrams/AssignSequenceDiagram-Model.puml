@startuml
!include style.puml
skinparam ArrowFontStyle plain

mainframe sd Assign membership (model)

box Model MODEL_COLOR_T1
participant "m:ModelManager" as Model MODEL_COLOR
participant ":AddressBook" as AddressBook MODEL_COLOR
participant "academicClass:AcademicClass" as AcademicClass MODEL_COLOR
end box

    [-> Model : assignStudentToClass(person, academicClass)
    activate Model

    Model -> AddressBook : assignStudentToClass(person, academicClass)
    activate AddressBook

    note over AddressBook
    Assertions check that the arguments
    are the stored student and class.
    end note

    AddressBook -> AcademicClass : assignStudent(person)
    activate AcademicClass
    note over AcademicClass
    Add person to the student set.
    The set prevents duplicate membership.
    end note
    AcademicClass --> AddressBook : true
    deactivate AcademicClass

    AddressBook --> Model : true
    deactivate AddressBook

    [<-- Model : true
    deactivate Model
@enduml
